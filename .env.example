# Copy to .env and fill in. Never commit .env.
BACKEND_URL=http://localhost:8000
# Spoken out loud by the speaker, so write it the way you'd say it
CAMERA_LOCATION=Platform 2, north stairs
GEMINI_API_KEY=

# Speaker announcements (Mac voice through the current sound output: laptop speakers, JBL, ...)
SPEAKER_ENABLED=1
SPEAKER_REPEAT_SECONDS=20
